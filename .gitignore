_site/
.jekyll-cache/
.jekyll-metadata
.bundle/
/vendor/

# Firebase config is generated at build time from GitHub Secrets — never commit it
assets/firebase-config.js
.DS_Store

# Material-fonte usado para gerar o conteúdo do site /china/ — não publicar
china/china-repositorio/

# Material-fonte, pesquisa e exports 4K do /radardesinais/ — não publicar
radardesinais/radar-repositorio/*
# ...mas a fonte dos slides e os scripts de build ficam versionados. Eles
# seguem fora do site: o _config.yml exclui radar-repositorio do build.
!radardesinais/radar-repositorio/*.html
!radardesinais/radar-repositorio/*.py
radardesinais/radar-repositorio/_*.html
